[Unit]
Description=llama.cpp Server (Qwen3.8-27B) auf 127.0.0.1:8000
Documentation=file:///home/uchralt/local_agentic_system/system/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/uchralt/local_agentic_system/system/start.sh
WorkingDirectory=/home/uchralt/local_agentic_system/system

# Das Modell wird mit --load-mode mlock geladen; das dauert einige Sekunden.
TimeoutStartSec=300
TimeoutStopSec=60

Restart=on-failure
RestartSec=10

# Nach fuenf Fehlstarts in zehn Minuten aufgeben, statt endlos zu kreisen.
StartLimitIntervalSec=600
StartLimitBurst=5

# mlock braucht ein Speicherlimit; ulimit -l liegt hier bei ca. 7,8 GiB.
# Mit -ngl 99 liegen die Gewichte im VRAM, host-seitig bleibt wenig zu sperren.
LimitMEMLOCK=infinity

StandardOutput=append:/home/uchralt/local_agentic_system/system/logs/llama-server.log
StandardError=append:/home/uchralt/local_agentic_system/system/logs/llama-server.log

# --- Speichergrenze, 28.08.2026 --------------------------------------
# Gemessen 17,7 GiB RSS -- das Modell liegt wegen --load-mode mlock auch im
# RAM. Q5 braucht mehr als Q4, deshalb Luft bis 26G. Darueber ist etwas
# kaputt, und dann soll dieser Dienst sterben und nicht die Maschine.
# MemoryHigh drosselt und raeumt auf, MemoryMax toetet. cgroup v2, kein sudo.
MemoryHigh=20G
MemoryMax=26G
MemorySwapMax=2G
OOMPolicy=stop

[Install]
WantedBy=default.target
